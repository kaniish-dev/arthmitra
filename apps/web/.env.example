# Firebase web app config (Firebase console → Project settings → Your apps).
# These keys are public by design; Firestore security rules protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional hackathon demo account (login page button); leave empty to hide it.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Gemini (free tier, Google AI Studio). Used by the Coach and the dashboard savings explanation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Third-party investment app the "Invest" buttons open. No broker is named in the prototype.
# The URL may use {category}, {amount} and {goal}, e.g. https://partner.example/invest?type={category}&amt={amount};
# otherwise category, amount, goal and source=arthmitra are added as query parameters.
NEXT_PUBLIC_PARTNER_NAME=
NEXT_PUBLIC_PARTNER_URL=
